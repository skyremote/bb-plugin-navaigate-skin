{
  "name": "bb-plugin-navaigate-skin",
  "version": "0.5.0",
  "type": "module",
  "engines": {
    "bb": ">=0.44",
    "bbPluginSdk": ">=0.5.29"
  },
  "bb": {
    "name": "NavAIgate Workspace",
    "description": "NavAIgate Workspace for bb: run-sheet sidebar with tags, later flags, folders and multi-select; a to-do list linked to chats and folders with a self-moving Board; Control room; usage dock; charts in replies; the NavAIgate theme.",
    "branding": {
      "icon": "./icons/workspace.svg",
      "experimental_icons": {
        "contrast": "./icons/contrast.svg",
        "board": "./icons/board.svg",
        "todo": "./icons/todo.svg"
      }
    },
    "server": "./server.ts",
    "app": "./app.tsx",
    "skills": [
      "skills"
    ],
    "themes": [
      {
        "id": "navaigate",
        "name": "NavAIgate",
        "description": "GPLS platform tokens. Warm paper and ink, gold for now, no blue.",
        "css": "./themes/navaigate.css",
        "codeTheme": {
          "dark": "vitesse-dark",
          "light": "vitesse-light"
        }
      }
    ]
  },
  "dependencies": {
    "@radix-ui/react-slot": "^1.3.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@get-bb/plugin-sdk": "0.5.29",
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "better-sqlite3": "^12.0.0",
    "cron-parser": "^5.5.0",
    "hono": "^4.11.9",
    "typescript": "^5.7.0",
    "@pierre/diffs": "^1.2.9",
    "@radix-ui/react-alert-dialog": "^1.1.19",
    "@radix-ui/react-context-menu": "^2.3.3",
    "@radix-ui/react-dialog": "^1.1.19",
    "@radix-ui/react-dropdown-menu": "^2.1.20",
    "@radix-ui/react-hover-card": "^1.1.19",
    "@radix-ui/react-menubar": "^1.1.20",
    "@radix-ui/react-navigation-menu": "^1.2.18",
    "@radix-ui/react-popover": "^1.1.19",
    "@radix-ui/react-select": "^2.3.3",
    "@radix-ui/react-tooltip": "^1.2.12",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "sonner": "^1.7.4",
    "tailwind-merge": "^3.4.0",
    "vaul": "^1.1.2"
